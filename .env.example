# PostgreSQL
POSTGRES_DB=orbitagro
POSTGRES_USER=orbitagro
POSTGRES_PASSWORD=orbitagro123
POSTGRES_PORT=5432

# API Spring Boot
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orbitagro
SPRING_DATASOURCE_USERNAME=orbitagro
SPRING_DATASOURCE_PASSWORD=orbitagro123
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Azure (scripts de provisionamento)
AZURE_RESOURCE_GROUP=rg-orbitagro-564099
AZURE_LOCATION=brazilsouth
AZURE_VM_NAME=vm-orbitagro-564099
AZURE_VM_SIZE=Standard_B2s
AZURE_ADMIN_USERNAME=azureuser
AZURE_SSH_KEY_PATH=~/.ssh/id_rsa.pub
